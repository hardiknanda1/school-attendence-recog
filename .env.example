# Contact form delivery — configure ONE option. Until one is set, the contact
# form clearly tells visitors their message was NOT sent (HTTP 503).
# These are read only on the server and are never exposed to the browser.

# Option 1: Webhook (CRM, Zapier/Make, Slack workflow, your own backend).
# Receives the enquiry as JSON via POST. Must respond 2xx to count as sent.
CONTACT_WEBHOOK_URL=
# Optional: sent as "Authorization: Bearer <secret>" so the receiver can verify the caller.
CONTACT_WEBHOOK_SECRET=

# Option 2: Email via Resend (https://resend.com).
RESEND_API_KEY=
# Comma-separated recipient list, e.g. team@example.org
CONTACT_TO_EMAIL=
# Must be a sender on a domain verified in Resend, e.g. "Website <noreply@example.org>"
CONTACT_FROM_EMAIL=
